<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Purchase access hierarchy:
            User -> Operator -> Coordinator -> Supervisor -> Administrator
        -->

        <record id="group_purchase_operator" model="res.groups">
            <field name="name">Operator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <record id="group_purchase_coordinator" model="res.groups">
            <field name="name">Coordinator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
            <field name="implied_ids" eval="[(4, ref('purchase_enhancement.group_purchase_operator'))]"/>
        </record>

        <record id="group_purchase_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
            <field name="implied_ids" eval="[(4, ref('purchase_enhancement.group_purchase_coordinator'))]"/>
        </record>

        <!-- Keep the standard Purchase Administrator group, but place it last. -->
        <record id="purchase.group_purchase_manager" model="res.groups">
            <field name="sequence">50</field>
            <field name="implied_ids" eval="[
                (3, ref('purchase.group_purchase_user')),
                (4, ref('purchase_enhancement.group_purchase_supervisor'))
            ]"/>
        </record>

    </data>
</odoo>

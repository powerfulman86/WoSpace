<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Sales access hierarchy:
            User: Own Documents Only
                -> User: All Documents
                -> Coordinator
                -> Supervisor
                -> Administrator
        -->

        <record id="group_sale_coordinator" model="res.groups">
            <field name="name">Coordinator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <record id="group_sale_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
            <field name="implied_ids" eval="[(4, ref('sale_enhancement.group_sale_coordinator'))]"/>
        </record>

        <!-- Preserve all other standard Administrator implications. -->
        <record id="sales_team.group_sale_manager" model="res.groups">
            <field name="sequence">50</field>
            <field name="implied_ids" eval="[
                (3, ref('sales_team.group_sale_salesman_all_leads')),
                (4, ref('sale_enhancement.group_sale_supervisor'))
            ]"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Inventory access hierarchy:
            User -> Operator -> Coordinator -> Supervisor -> Administrator
        -->

        <record id="group_stock_operator" model="res.groups">
            <field name="name">Operator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_stock_coordinator" model="res.groups">
            <field name="name">Coordinator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock_enhancement.group_stock_operator'))]"/>
        </record>

        <record id="group_stock_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="stock.res_groups_privilege_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock_enhancement.group_stock_coordinator'))]"/>
        </record>

        <!-- Keep the standard Inventory Administrator group, but place it last. -->
        <record id="stock.group_stock_manager" model="res.groups">
            <field name="sequence">50</field>
            <field name="implied_ids" eval="[
                (3, ref('stock.group_stock_user')),
                (4, ref('stock_enhancement.group_stock_supervisor'))
            ]"/>
        </record>

    </data>
</odoo>

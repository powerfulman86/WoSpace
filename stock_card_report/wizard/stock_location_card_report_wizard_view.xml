<odoo>

    <record id="stock_location_card_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.location.card.report.wizard.form</field>
        <field name="model">stock.location.card.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group name="criteria">
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" widget="many2many_tags" placeholder="Leave empty for all warehouses"/>
                        <field name="location_ids" widget="many2many_tags" placeholder="Leave empty for all internal locations; select transit locations if needed"/>
                        <field name="product_categ_ids" widget="many2many_tags" placeholder="Leave empty for all categories"/>
                        <field name="product_ids" widget="many2many_tags" placeholder="Leave empty for all products"/>
                    </group>
                </group>
                <footer>
                    <button name="button_export_html" string="View"
                            type="object" default_focus="1" class="oe_highlight"/>
                    <button name="button_view_lines" string="View List/Pivot" type="object"/>
                    <button name="button_export_pdf" string="Export PDF" type="object"/>
                    <button name="button_export_xlsx" string="Export Excel" type="object"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_location_card_report_action" model="ir.actions.act_window">
        <field name="name">Location Card</field>
        <field name="res_model">stock.location.card.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="stock_location_card_report_menu"
              name="Location Card"
              action="stock_location_card_report_action"
              parent="stock_card_report.stock_card_report_menu"
              sequence="2"/>

</odoo>

<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="view_task_form2_inherited_validate" model="ir.ui.view">
            <field name="name">view_task_form2_inherited Validate</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='timesheet_ids']/list/field[@name='company_id']" position="after">

                    <field name="contracting_validated" invisible="1"/>
                    <button name="action_validate_line" title="Validate"
                            icon="fa-cloud-download" type="object"
                            invisible="contracting_validated == True"/>
                </xpath>
            </field>
        </record>
    
        <record id="view_project_form_contracting_delete_confirm" model="ir.ui.view">
            <field name="name">project.project.form.contracting.delete.confirm</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="is_contracting_project" readonly="1"/>
                </xpath>
                <xpath expr="//form/header" position="inside">
                    <field name="is_contracting_project" invisible="1"/>
                    <button name="action_confirm_contracting_delete"
                            string="Delete Contracting Project"
                            type="object"
                            class="btn-danger"
                            groups="contracting_management.sale_contracting_user"
                            invisible="not is_contracting_project"/>
                </xpath>
            </field>
        </record>
</data>
</odoo>
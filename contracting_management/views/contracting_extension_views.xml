<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--contracting Variation reason-->
    <record id="contracting_variation_reason_tree" model="ir.ui.view">
        <field name="name">contracting.variation.reason.tree</field>
        <field name="model">contracting.variation.reason</field>
        <field name="arch" type="xml">
            <list string="Variation Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="variation_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="contracting_variation_reason_action" model="ir.actions.act_window">
        <field name="name">Variation Reasons</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">contracting.variation.reason</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click create a new Contracting Variation Reason.
            </p>
        </field>
    </record>

    <menuitem id="contracting_variation_reason"
              name="Variation Reasons"
              parent="menu_contracting_management_configuration"
              sequence="4"
              action="contracting_variation_reason_action"/>

    <!--contracting Variation Order-->
    <record id="contracting_variation_order_kanban" model="ir.ui.view">
        <field name="name">contracting.variation.order.kanban</field>
        <field name="model">contracting.variation.order</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="internal_reference"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="order_date"/>
                <field name="reason_id"/>
                <field name="variation_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="company_id"/>
                <templates class="oe_background_grey o_kanban_dashboard o_subscription_kanban">
                    <t t-name="card">
                    </t>
                </templates>
            </kanban>
        </field>
    </record>



    <record id="contracting_variation_order_tree" model="ir.ui.view">
        <field name="name">contracting.variation.order.tree</field>
        <field name="model">contracting.variation.order</field>
        <field name="arch" type="xml">
            <list string="Contract Variation Order">
                <field name="internal_reference" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="contract_id" readonly="1"/>
                <field name="order_date" readonly="1"/>
                <field name="reason_id"/>
                <field name="variation_amount" sum="Total Tax Included" widget="monetary" decoration-bf="1"
                       optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="contracting_variation_order_action" model="ir.actions.act_window">
        <field name="name">Contracts Variation Order</field>
        <field name="res_model">contracting.variation.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Contract Variation Order
            </p>
        </field>
    </record>

    <menuitem id="contracting_variation_order"
              name="Variation Order"
              parent="menu_contracting_management"
              sequence="2"
              action="contracting_variation_order_action"/>
</odoo>
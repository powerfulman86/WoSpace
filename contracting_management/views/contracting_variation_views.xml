<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--contracting Variation reason-->
    <record id="contracting_variation_reason_tree" model="ir.ui.view">
        <field name="name">contracting.variation.reason.tree</field>
        <field name="model">contracting.variation.reason</field>
        <field name="arch" type="xml">
            <list string="Variation Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="description"/>
                <field name="variation_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="contracting_variation_reason_action" model="ir.actions.act_window">
        <field name="name">Variation Reasons</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">contracting.variation.reason</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click create a new Contracting Variation Reason.
            </p>
        </field>
    </record>

    <menuitem id="contracting_variation_reason"
              name="Variation Reasons"
              parent="menu_contracting_management_configuration"
              sequence="4"
              action="contracting_variation_reason_action"/>

    <!--contracting Variation Order-->
    <record id="contracting_variation_order_kanban" model="ir.ui.view">
        <field name="name">contracting.variation.order.kanban</field>
        <field name="model">contracting.variation.order</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="internal_reference"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="order_date"/>
                <field name="reason_id"/>
                <field name="variation_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="company_id"/>
                <templates class="oe_background_grey o_kanban_dashboard o_subscription_kanban">
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div>
                                    <strong>
                                        <div class="float-right">
                                            <field name="internal_reference"/>
                                        </div>
                                        <field name="partner_id"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <span class="float-right">
                                        <field name="order_date"/>
                                    </span>

                                </div>
                            </div>
                            <div class="oe_clear"></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="contracting_variation_order_form" model="ir.ui.view">
        <field name="name">contracting.variation.order.form</field>
        <field name="model">contracting.variation.order</field>
        <field name="arch" type="xml">
            <form string="Contract Variation Order">
                <header>
                    <button name="action_confirm" string="Confirm" class="btn-primary" type="object"
                            invisible="state not in ['draft']"/>
                    <button name="action_cancel" string="Cancel" class="btn-primary" type="object"
                            invisible="state not in ['draft']"/>
                    <field name="state" widget="statusbar" options="{'clickable': '0'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="internal_reference" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="order_date"/>
                            <field name="reason_id"/>
                            <field name="variation_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <field name="order_lines" widget="section_and_note_one2many"
                                   mode="list" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="line_type"/>
                                    <field name="description"/>
                                    <field name="original_total"/>
                                    <field name="supplier_id"
                                           required="line_type == 'subcontract'"/>
                                    <field name="planned_hours"
                                           required="line_type in ('labour','subcontract')"/>
                                    <field name="product_qty"
                                           required="line_type in ('material','overhead')"/>
                                    <field name="price_unit" required="is_modifiable == True"/>
                                    <field name="price_total"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="is_modifiable" invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                                    <field name="variation_cost" widget='monetary'
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="contracting_variation_order_tree" model="ir.ui.view">
        <field name="name">contracting.variation.order.tree</field>
        <field name="model">contracting.variation.order</field>
        <field name="arch" type="xml">
            <list string="Variation Order" decoration-info="state == 'draft'"
                  decoration-bf="state == 'done'"
                  decoration-muted="state=='cancel'">
                <field name="internal_reference" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="contract_id" readonly="1"/>
                <field name="order_date" readonly="1"/>
                <field name="reason_id"/>
                <field name="variation_cost"/>
                <field name="variation_amount" sum="Sum of Variation Amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="contracting_variation_order_action" model="ir.actions.act_window">
        <field name="name">Variation Order</field>
        <field name="res_model">contracting.variation.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Contract Variation Order
            </p>
        </field>
    </record>

    <menuitem id="contracting_variation_order"
              name="Variation Order"
              parent="menu_contracting_management"
              sequence="2"
              action="contracting_variation_order_action"/>
</odoo>
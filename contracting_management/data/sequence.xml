<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sequence_contract_order" model="ir.sequence">
            <field name="name">Contracting Order sequence</field>
            <field name="code">contracting.order</field>
            <field name="prefix">CO/%(range_year)s/</field>
            <field name="number_next" eval="1"/>
            <field name="number_increment" eval="1"/>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="padding">4</field>
        </record>

        <record id="sequence_sub_contract_order" model="ir.sequence">
            <field name="name">SUb Contracting Order sequence</field>
            <field name="code">contracting.order.sub</field>
            <field name="prefix">SCO/%(range_year)s/</field>
            <field name="number_next" eval="1"/>
            <field name="number_increment" eval="1"/>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="padding">4</field>
        </record>

        <record id="sequence_contract_variation_extension" model="ir.sequence">
            <field name="name">Contracting Variation Order sequence</field>
            <field name="code">contracting.variation.order</field>
            <field name="prefix">CVO/%(range_year)s/</field>
            <field name="number_next" eval="1"/>
            <field name="number_increment" eval="1"/>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
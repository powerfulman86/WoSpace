<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--contract stage-->
        <record id="sale_contracting_stage_new" model="contracting.order.stage">
            <field name="name">New</field>
            <field name="in_progress">False</field>
            <field name="sequence">1</field>
        </record>

        <record id="sale_contracting_stage_approved" model="contracting.order.stage">
            <field name="name">Approved</field>
            <field name="in_progress">False</field>
            <field name="sequence">2</field>
        </record>

        <record id="sale_contracting_stage_processing" model="contracting.order.stage">
            <field name="name">Processing</field>
            <field name="in_progress">True</field>
            <field name="sequence">3</field>
        </record>

        <record id="sale_contracting_stage_hold" model="contracting.order.stage">
            <field name="name">Hold</field>
            <field name="in_progress">False</field>
            <field name="sequence">4</field>
        </record>

        <record id="sale_contracting_stage_close" model="contracting.order.stage">
            <field name="name">Close</field>
            <field name="in_progress">False</field>
            <field name="sequence">5</field>
        </record>

        <record id="sale_contracting_stage_cancel" model="contracting.order.stage">
            <field name="name">Cancel</field>
            <field name="in_progress">False</field>
            <field name="sequence">6</field>
        </record>

        <!--contract Template-->
        <record id="sale_contracting_template_install" model="contracting.order.template">
            <field name="name">Installation</field>
            <field name="code">INT</field>
        </record>

        <record id="sale_contracting_template_maintenance" model="contracting.order.template">
            <field name="name">Maintenance</field>
            <field name="code">MIT</field>
        </record>

    </data>
</odoo>
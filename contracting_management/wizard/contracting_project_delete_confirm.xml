<odoo>
    <record id="view_contracting_project_delete_confirm_form" model="ir.ui.view">
        <field name="name">contracting.project.delete.confirm.form</field>
        <field name="model">contracting.project.delete.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirm Project Deletion">
                <group>
                    <field name="project_id"/>
                    <div class="alert alert-warning" role="alert">
                        This project is linked to a Contracting Order. Deleting it will remove the project link from the contract. This action cannot be undone.
                    </div>
                </group>
                <footer>
                    <button name="action_confirm_delete" string="Delete Project" type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
